---
import WhatsApp from "../assets/icons/whatsapp.svg";
import { whatsappLink } from "../data/site";
---

<section class="closing">
  <div class="container closing__inner reveal">
    <h2 class="display">Tu próximo turno,<br /><strong>a un mensaje de distancia.</strong></h2>
    <a class="btn btn--dark" href={whatsappLink()} target="_blank" rel="noopener">
      <WhatsApp aria-hidden="true" fill="currentColor" />
      Reserva tu turno
    </a>
  </div>
</section>

<style>
  .closing {
    padding-block: clamp(88px, 11vw, 150px);
    background: var(--mist);
  }

  .closing__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }

  @media (max-width: 860px) {
    .closing__inner {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
