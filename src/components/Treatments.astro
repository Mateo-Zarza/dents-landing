---
import { treatments } from "../data/site";
---

<section id="tratamientos" class="section treatments">
  <div class="container">
    <div class="treatments__head reveal">
      <p class="eyebrow">Tratamientos</p>
      <h2 class="display">Todo lo que tu sonrisa necesita, <strong>en un solo lugar.</strong></h2>
    </div>

    <div class="treatments__grid">
      {
        treatments.map((group, i) => (
          <div class="treatments__group reveal reveal--pop">
            <span class="treatments__index">{String(i + 1).padStart(2, "0")}</span>
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li>
                  {/* A shared name makes the browser keep a single one open */}
                  <details name="tratamiento">
                    <summary>
                      {item.name}
                      <span class="treatments__toggle" aria-hidden="true" />
                    </summary>
                    <p>{item.description}</p>
                  </details>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .treatments {
    background: var(--white);
  }

  .treatments__head {
    max-width: 46rem;
  }

  .treatments__head .display {
    margin-top: 24px;
  }

  .treatments__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(32px, 4vw, 56px);
    margin-top: clamp(56px, 8vw, 104px);
  }

  .treatments__group {
    padding-top: 28px;
    border-top: 1px solid var(--ink);
  }

  .treatments__index {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--stone);
  }

  .treatments__group h3 {
    margin-top: 10px;
    margin-bottom: 20px;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .treatments__group li {
    border-bottom: 1px solid var(--line);
  }

  .treatments__group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
    font-weight: 500;
    line-height: 1.4;
    list-style: none;
    cursor: pointer;
    transition: color 0.3s var(--ease);
  }

  .treatments__group summary::-webkit-details-marker {
    display: none;
  }

  .treatments__group summary:hover {
    color: var(--text-soft);
  }

  /* Plus that folds into a minus when open */
  .treatments__toggle {
    position: relative;
    flex: none;
    width: 11px;
    height: 11px;
    color: var(--stone);
  }

  .treatments__toggle::before,
  .treatments__toggle::after {
    content: "";
    position: absolute;
    inset: 5px 0 auto;
    height: 1px;
    background: currentColor;
    transition: transform 0.4s var(--ease);
  }

  .treatments__toggle::after {
    transform: rotate(90deg);
  }

  details[open] .treatments__toggle::after {
    transform: none;
  }

  .treatments__group details p {
    padding-bottom: 16px;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-soft);
    text-wrap: pretty;
  }

  details[open] p {
    animation: treatment-open 0.5s var(--ease);
  }

  @keyframes treatment-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  /* Smooth height where the browser can animate to auto; elsewhere it opens instantly */
  @supports (interpolate-size: allow-keywords) {
    .treatments__group details {
      interpolate-size: allow-keywords;
    }

    .treatments__group details::details-content {
      block-size: 0;
      overflow-y: clip;
      transition:
        block-size 0.45s var(--ease),
        content-visibility 0.45s allow-discrete;
    }

    .treatments__group details[open]::details-content {
      block-size: auto;
    }
  }

  /* In four columns some titles wrap; reserve two lines so the lists line up */
  @media (min-width: 1001px) {
    .treatments__group h3 {
      min-height: 2lh;
    }
  }

  @media (max-width: 1000px) {
    .treatments__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .treatments__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
