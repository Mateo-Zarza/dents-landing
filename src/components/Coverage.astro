---
import Isologo from "../assets/brand/isologo.svg";
import { coverages, whatsappLink } from "../data/site";
---

<section id="coberturas" class="section coverage">
  <Isologo class="coverage__mark" aria-hidden="true" />

  <div class="container coverage__inner">
    <div class="coverage__head reveal">
      <p class="eyebrow">Coberturas</p>
      <h2 class="display">
        Trabajamos con las principales <strong>obras sociales y prepagas.</strong>
      </h2>
    </div>

    <div class="coverage__grid reveal">
      <ul>
        {coverages.map((name) => <li>{name}</li>)}
      </ul>
    </div>

    <p class="coverage__note reveal">
      Y pacientes particulares.
      <a
        href={whatsappLink("Hola Dents, quería consultar si atienden con mi obra social.")}
        target="_blank"
        rel="noopener"
      >
        Consultá tu cobertura <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<style>
  .coverage {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--white);
  }

  .coverage :global(.coverage__mark) {
    position: absolute;
    top: 50%;
    right: -6%;
    width: clamp(320px, 42vw, 620px);
    height: auto;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.035);
    pointer-events: none;
  }

  .coverage__inner {
    position: relative;
  }

  .coverage__head {
    max-width: 46rem;
  }

  .coverage__head .display {
    margin-top: 24px;
  }

  /* Inner hairlines only: cells draw right/bottom borders and the wrapper
     clips the outer ones, so it works for any column count. */
  .coverage__grid {
    margin-top: clamp(48px, 7vw, 88px);
    border-block: 1px solid var(--line-light);
    overflow: hidden;
  }

  .coverage__grid ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0 -1px -1px 0;
  }

  .coverage__grid li {
    display: grid;
    place-items: center;
    min-height: clamp(96px, 10vw, 128px);
    padding: 20px 12px;
    border-right: 1px solid var(--line-light);
    border-bottom: 1px solid var(--line-light);
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    transition: background-color 0.4s var(--ease);
  }

  .coverage__grid li:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .coverage__note {
    margin-top: 32px;
    color: rgba(255, 255, 255, 0.6);
  }

  .coverage__note a {
    margin-left: 10px;
    color: var(--white);
    font-weight: 600;
    border-bottom: 1px solid var(--line-light);
    transition: border-color 0.3s var(--ease);
  }

  .coverage__note a:hover {
    border-color: var(--white);
  }

  @media (max-width: 700px) {
    .coverage__grid ul {
      grid-template-columns: repeat(2, 1fr);
    }

    .coverage__grid li {
      min-height: 84px;
      font-size: 0.92rem;
      letter-spacing: 0.08em;
    }

    .coverage__grid li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .coverage__note a {
      display: inline-block;
      margin: 8px 0 0;
    }
  }
</style>
