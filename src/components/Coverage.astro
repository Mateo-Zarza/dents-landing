---
import Isologo from "../assets/brand/isologo.svg";
import { coverages, whatsappLink } from "../data/site";
---

<section id="coberturas" class="section coverage">
  <Isologo class="coverage__mark" aria-hidden="true" />

  <div class="container coverage__inner">
    <div class="coverage__head reveal">
      <p class="eyebrow">Coberturas</p>
      <h2 class="display">
        Trabajamos con las principales <strong>obras sociales y prepagas.</strong>
      </h2>
    </div>

    <ul class="coverage__grid reveal">
      {coverages.map((name) => <li>{name}</li>)}
    </ul>

    <p class="coverage__note reveal">
      Y pacientes particulares.
      <a
        href={whatsappLink("Hola Dents, quería consultar si atienden con mi obra social.")}
        target="_blank"
        rel="noopener"
      >
        Consultá tu cobertura <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<style>
  .coverage {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--white);
  }

  .coverage :global(.coverage__mark) {
    position: absolute;
    top: 50%;
    right: -6%;
    width: clamp(320px, 42vw, 620px);
    height: auto;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.035);
    pointer-events: none;
  }

  .coverage__inner {
    position: relative;
  }

  .coverage__head {
    max-width: 46rem;
  }

  .coverage__head .display {
    margin-top: 24px;
  }

  /* Brick layout for the 9 coverages: 5 on top, 4 below shifted half a block.
     Blocks span 2 of 10 columns; each draws right/bottom borders and only the
     outer edges add top/left, so no line is doubled. */
  .coverage__grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    margin-top: clamp(48px, 7vw, 88px);
  }

  .coverage__grid li {
    grid-column: span 2;
    display: grid;
    place-items: center;
    min-height: 76px;
    padding: 14px 12px;
    border-right: 1px solid var(--line-light);
    border-bottom: 1px solid var(--line-light);
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    transition: background-color 0.4s var(--ease);
  }

  .coverage__grid li:nth-child(-n + 5) {
    border-top: 1px solid var(--line-light);
  }

  .coverage__grid li:nth-child(1),
  .coverage__grid li:nth-child(6) {
    border-left: 1px solid var(--line-light);
  }

  .coverage__grid li:nth-child(6) {
    grid-column: 2 / span 2;
  }

  .coverage__grid li:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .coverage__note {
    margin-top: 32px;
    color: rgba(255, 255, 255, 0.6);
  }

  .coverage__note a {
    margin-left: 10px;
    color: var(--white);
    font-weight: 600;
    border-bottom: 1px solid var(--line-light);
    transition: border-color 0.3s var(--ease);
  }

  .coverage__note a:hover {
    border-color: var(--white);
  }

  /* Two per row; the odd last block is centered by the same half-block shift. */
  @media (max-width: 860px) {
    .coverage__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .coverage__grid li:nth-child(n) {
      grid-column: span 2;
      min-height: 68px;
      border-top: 0;
      border-left: 0;
      font-size: 0.92rem;
      letter-spacing: 0.08em;
    }

    .coverage__grid li:nth-child(-n + 2) {
      border-top: 1px solid var(--line-light);
    }

    .coverage__grid li:nth-child(odd) {
      border-left: 1px solid var(--line-light);
    }

    .coverage__grid li:last-child:nth-child(odd) {
      grid-column: 2 / span 2;
    }
  }

  @media (max-width: 700px) {
    .coverage__note a {
      display: inline-block;
      margin: 8px 0 0;
    }
  }
</style>
