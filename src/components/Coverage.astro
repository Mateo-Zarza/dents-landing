---
import Isologo from "../assets/brand/isologo.svg";
import { coverages, whatsappLink } from "../data/site";

// Logos live in src/assets/coverages, named after the coverage
// ("Sancor Salud" -> sancor-salud.svg). Without a file the name is shown instead.
const logoFiles = import.meta.glob<string>("../assets/coverages/*.{svg,png,webp}", {
  eager: true,
  query: "?url",
  import: "default",
});

const slug = (name: string) =>
  name.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().replace(/\s+/g, "-");

const logoFor = (name: string) =>
  Object.entries(logoFiles).find(([path]) => path.split("/").pop()!.replace(/\.\w+$/, "") === slug(name))?.[1];

// Optical balance: compact bold wordmarks read bigger than logos with taglines.
const logoScale: Record<string, number> = { osde: 0.66, apross: 0.84 };
---

<section id="coberturas" class="section coverage">
  <Isologo class="coverage__mark" aria-hidden="true" />

  <div class="container coverage__inner">
    <div class="coverage__head reveal">
      <p class="eyebrow">Coberturas</p>
      <h2 class="display">
        Trabajamos con las principales <strong>obras sociales y prepagas.</strong>
      </h2>
    </div>

    <ul class="coverage__logos reveal">
      {
        coverages.map((name) => {
          const logo = logoFor(name);
          return (
            <li style={`--scale: ${logoScale[slug(name)] ?? 1}`}>
              {logo ? <img src={logo} alt={name} loading="lazy" decoding="async" /> : <span>{name}</span>}
            </li>
          );
        })
      }
    </ul>

    <p class="coverage__note reveal">
      Y pacientes particulares.
      <a
        href={whatsappLink("Hola Dents, quería consultar si atienden con mi obra social.")}
        target="_blank"
        rel="noopener"
      >
        Consultá tu cobertura <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<style>
  .coverage {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--white);
  }

  .coverage :global(.coverage__mark) {
    position: absolute;
    top: 50%;
    right: -6%;
    width: clamp(320px, 42vw, 620px);
    height: auto;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.035);
    pointer-events: none;
  }

  .coverage__inner {
    position: relative;
  }

  .coverage__head {
    max-width: 46rem;
  }

  .coverage__head .display {
    margin-top: 24px;
  }

  /* 5 on top, 4 below shifted half a slot so the bottom row sits centered:
     each logo spans 2 of 10 columns and the 6th starts at column 2. */
  .coverage__logos {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    row-gap: clamp(40px, 5vw, 64px);
    margin-top: clamp(56px, 8vw, 104px);
  }

  .coverage__logos li {
    grid-column: span 2;
    display: grid;
    place-items: center;
    height: 46px;
    padding-inline: clamp(14px, 2.4vw, 32px);
  }

  .coverage__logos li:nth-child(6) {
    grid-column: 2 / span 2;
  }

  /* Monochrome white so the brands' own colors don't fight the palette */
  .coverage__logos img {
    width: 100%;
    height: calc(100% * var(--scale));
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.78;
    transition: opacity 0.4s var(--ease);
  }

  .coverage__logos span {
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.78;
    transition: opacity 0.4s var(--ease);
  }

  .coverage__logos li:hover > * {
    opacity: 1;
  }

  .coverage__note {
    margin-top: clamp(56px, 7vw, 88px);
    color: rgba(255, 255, 255, 0.6);
  }

  .coverage__note a {
    margin-left: 10px;
    color: var(--white);
    font-weight: 600;
    border-bottom: 1px solid var(--line-light);
    transition: border-color 0.3s var(--ease);
  }

  .coverage__note a:hover {
    border-color: var(--white);
  }

  @media (max-width: 860px) {
    .coverage__logos {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 36px;
    }

    .coverage__logos li:nth-child(n) {
      grid-column: auto;
      height: 38px;
      padding-inline: 10px;
    }

    .coverage__logos span {
      font-size: 0.85rem;
      letter-spacing: 0.08em;
    }
  }

  @media (max-width: 700px) {
    .coverage__note a {
      display: inline-block;
      margin: 8px 0 0;
    }
  }
</style>
